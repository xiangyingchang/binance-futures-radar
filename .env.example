# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Whale Intelligence
# No key is required: the module falls back to public Ethereum RPC endpoints.
# Optional: set your own RPC for better reliability / higher rate limits.
ETHEREUM_RPC_URL=https://your-ethereum-rpc.example

# V3 Execution Ledger (server-side only; never expose the GitHub token)
EXECUTION_LEDGER_API_KEY=replace_with_a_separate_write_key
GITHUB_EXECUTION_LEDGER_TOKEN=replace_with_a_fine_grained_contents_token
GITHUB_EXECUTION_LEDGER_REPO=xiangyingchang/binance-futures-radar
GITHUB_EXECUTION_LEDGER_BRANCH=main
