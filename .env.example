# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Whale Intelligence
# No key is required: the module falls back to public Ethereum RPC endpoints.
# Optional: set your own RPC for better reliability / higher rate limits.
ETHEREUM_RPC_URL=https://your-ethereum-rpc.example

# V3 private tracking data (server-side only; never expose the GitHub token)
# Access key protects both GET and POST for Execution / Capital Flow / Account Snapshot.
V3_TRACKING_ACCESS_KEY=replace_with_a_separate_access_key
# Fine-grained PAT scoped only to the private data repo, Contents: Read and write.
GITHUB_V3_TRACKING_DATA_TOKEN=replace_with_a_fine_grained_contents_token
GITHUB_V3_TRACKING_DATA_REPO=xiangyingchang/binance-futures-radar-private-data
GITHUB_V3_TRACKING_DATA_BRANCH=main
